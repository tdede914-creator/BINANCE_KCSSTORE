# =========================================================================
# BINANCE FUTURES SIGNAL BOT — Environment Variables
# =========================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to git.

# -------------------------------------------------------------------------
# BACKEND
# -------------------------------------------------------------------------

# Application
APP_ENV=development            # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# Security (REQUIRED — generate a strong random key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_A_FERNET_KEY

# JWT for frontend session (any long random string)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_MINUTES=1440       # 24h

# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/signals

# Redis (used for pub/sub between scanner and API — optional in dev)
REDIS_URL=redis://redis:6379/0

# -------------------------------------------------------------------------
# BINANCE
# -------------------------------------------------------------------------

# Testnet (Binance Futures Testnet) — HIGHLY recommend true for first run
BINANCE_TESTNET=true

# Binance API endpoints (auto-selected by BINANCE_TESTNET flag)
# Do not usually change these
BINANCE_FUTURES_REST_MAINNET=https://fapi.binance.com
BINANCE_FUTURES_WS_MAINNET=wss://fstream.binance.com
BINANCE_FUTURES_REST_TESTNET=https://testnet.binancefuture.com
BINANCE_FUTURES_WS_TESTNET=wss://stream.binancefuture.com

# -------------------------------------------------------------------------
# BOT DEFAULTS (can be overridden in the UI)
# -------------------------------------------------------------------------

# Trading mode: paper | live
DEFAULT_TRADING_MODE=paper

# Paper trading starting balance (USDT)
PAPER_START_BALANCE=1000

# Risk per trade (% of equity)
RISK_PER_TRADE_PCT=1.0

# Default leverage
DEFAULT_LEVERAGE=5

# Watchlist (comma-separated Binance USDT-M perpetual symbols).
# Default list picks 10 high-volume coins that support small notionals so
# you can trade even with a tiny modal (BTC excluded — its min-notional
# is high because 0.001 BTC step size * price ≈ $60+).
DEFAULT_WATCHLIST=ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,SUIUSDT,1000PEPEUSDT

# Multi-timeframe config
BIAS_TIMEFRAME=4h              # 1h | 4h | 1d
SETUP_TIMEFRAME=1h             # 15m | 1h | 4h
ENTRY_TIMEFRAME=5m             # 1m | 3m | 5m | 15m — configurable per user

# Signal scanner interval (seconds) — how often to re-evaluate each pair
SCAN_INTERVAL_SECONDS=15

# -------------------------------------------------------------------------
# FRONTEND
# -------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
